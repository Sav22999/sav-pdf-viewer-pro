<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.settings.SettingsFragment">

    <ScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="0dp"
        android:paddingTop="0dp"
        android:paddingEnd="0dp"
        android:paddingBottom="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:text="@string/title_settings"
                android:textColor="@color/dark_red"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/viewer_defaults_scroll_mode"
                android:textColor="@color/dark_red"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/border_rounded"
                android:orientation="horizontal"
                android:weightSum="120">

                <ImageView
                    android:id="@+id/buttonDefaultScrollVTopToBottom"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="30"
                    android:background="@color/transparent"
                    android:contentDescription="@string/viewer_default_direction_v_ttb"
                    android:padding="18dp"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/ic_scroll_vertically_top2bottom"
                    app:tint="@color/white" />

                <ImageView
                    android:id="@+id/buttonDefaultScrollVBottomToTop"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="30"
                    android:background="@color/transparent"
                    android:contentDescription="@string/viewer_default_direction_v_btt"
                    android:padding="18dp"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/ic_scroll_vertically_bottom2top"
                    app:tint="@color/white" />

                <ImageView
                    android:id="@+id/buttonDefaultScrollHLeftToRight"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="30"
                    android:background="@color/transparent"
                    android:contentDescription="@string/viewer_default_direction_h_ltr"
                    android:padding="18dp"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/ic_scroll_horizontally_left2right"
                    app:tint="@color/white" />

                <ImageView
                    android:id="@+id/buttonDefaultScrollHRightToLeft"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="30"
                    android:background="@color/transparent"
                    android:contentDescription="@string/viewer_default_direction_h_rtl"
                    android:padding="18dp"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/ic_scroll_horizontally_right2left"
                    app:tint="@color/white" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/viewer_defaults_zoom"
                android:textColor="@color/dark_red"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/border_rounded"
                android:orientation="horizontal"
                android:weightSum="100">

                <ImageView
                    android:id="@+id/buttonDefaultZoomDecrease"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="30"
                    android:background="@color/transparent"
                    android:contentDescription="@string/tooltip_zoom_out"
                    android:padding="18dp"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/ic_zoom_out"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/buttonDefaultZoomValue"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="40"
                    android:contentDescription="@string/viewer_defaults_zoom"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:text="Auto" />

                <ImageView
                    android:id="@+id/buttonDefaultZoomIncrease"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="30"
                    android:background="@color/transparent"
                    android:contentDescription="@string/tooltip_zoom_in"
                    android:padding="18dp"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/ic_zoom_in"
                    app:tint="@color/white" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/viewer_defaults_single_page"
                android:textColor="@color/dark_red"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/border_rounded"
                android:orientation="horizontal"
                android:weightSum="100">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="50"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/buttonDefaultSinglePageOff"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@color/transparent"
                        android:contentDescription="@string/tooltip_single_page_scroll_disabled"
                        android:padding="12dp"
                        app:srcCompat="@drawable/ic_single_page_disabled"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="5dp"
                        android:text="@string/viewer_defaults_mode_off"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="50"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/buttonDefaultSinglePageOn"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@color/transparent"
                        android:contentDescription="@string/tooltip_single_page_scroll"
                        android:padding="12dp"
                        app:srcCompat="@drawable/ic_single_page"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="5dp"
                        android:text="@string/viewer_defaults_mode_on_short"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/viewer_defaults_rotation_locked"
                android:textColor="@color/dark_red"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/border_rounded"
                android:orientation="horizontal"
                android:weightSum="100">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="50"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/buttonDefaultRotationLockedOff"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@color/transparent"
                        android:contentDescription="@string/tooltip_unlock_rotation"
                        android:padding="10dp"
                        app:srcCompat="@drawable/ic_rotation_unlocked"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="5dp"
                        android:text="@string/viewer_defaults_mode_off"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="50"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/buttonDefaultRotationLockedOn"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@color/transparent"
                        android:contentDescription="@string/tooltip_lock_rotation"
                        android:padding="10dp"
                        app:srcCompat="@drawable/ic_rotation_locked"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="5dp"
                        android:text="@string/viewer_defaults_mode_on_short"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/viewer_defaults_toolbar_position"
                android:textColor="@color/dark_red"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/border_rounded"
                android:orientation="horizontal"
                android:weightSum="100">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="50"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/buttonDefaultToolbarTop"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@color/transparent"
                        android:contentDescription="@string/viewer_defaults_toolbar_position_top_content_description"
                        android:padding="12dp"
                        app:srcCompat="@drawable/ic_menubar_top"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="5dp"
                        android:text="@string/viewer_defaults_toolbar_position_top"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="50"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/buttonDefaultToolbarBottom"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@color/transparent"
                        android:contentDescription="@string/viewer_defaults_toolbar_position_bottom_content_description"
                        android:padding="12dp"
                        app:srcCompat="@drawable/ic_menubar_bottom"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="5dp"
                        android:text="@string/viewer_defaults_toolbar_position_bottom"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/viewer_defaults_fullscreen"
                android:textColor="@color/dark_red"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/border_rounded"
                android:orientation="horizontal"
                android:weightSum="100">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="50"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/buttonDefaultFullscreenOff"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@color/transparent"
                        android:contentDescription="@string/tooltip_full_screen_off"
                        android:padding="12dp"
                        app:srcCompat="@drawable/ic_exit_fullscreen"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="5dp"
                        android:text="@string/viewer_defaults_mode_off"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="50"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/buttonDefaultFullscreenOn"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@color/transparent"
                        android:contentDescription="@string/tooltip_full_screen_on"
                        android:padding="12dp"
                        app:srcCompat="@drawable/ic_fullscreen"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="5dp"
                        android:text="@string/viewer_defaults_mode_on_short"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/viewer_defaults_dark_filter_schedule"
                android:textColor="@color/dark_red"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/border_rounded"
                android:orientation="horizontal"
                android:weightSum="120">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="40"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/buttonDefaultNightModeOff"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@color/transparent"
                        android:contentDescription="@string/viewer_defaults_mode_off"
                        android:padding="10dp"
                        app:srcCompat="@drawable/ic_dark_filter_disabled"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/viewer_defaults_mode_off"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/buttonDefaultNightModeAuto"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="40"
                    android:gravity="center"
                    android:text="@string/viewer_defaults_mode_auto"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="40"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/buttonDefaultNightModeOn"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@color/transparent"
                        android:contentDescription="@string/viewer_defaults_mode_always_on"
                        android:padding="10dp"
                        app:srcCompat="@drawable/ic_dark_filter"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/viewer_defaults_mode_on_short"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/containerDarkFilterSchedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/border_rounded"
                android:orientation="horizontal"
                android:visibility="gone"
                android:weightSum="100">

                <TextView
                    android:id="@+id/buttonDefaultDarkFilterStartTime"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="50"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    tools:text="21:00" />

                <TextView
                    android:id="@+id/buttonDefaultDarkFilterEndTime"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="50"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    tools:text="07:00" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/viewer_defaults_night_light_schedule"
                android:textColor="@color/dark_red"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/border_rounded"
                android:orientation="horizontal"
                android:weightSum="120">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="40"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/buttonDefaultContrastOff"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@color/transparent"
                        android:contentDescription="@string/viewer_defaults_mode_off"
                        android:padding="10dp"
                        app:srcCompat="@drawable/ic_light_off"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/viewer_defaults_mode_off"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/buttonDefaultContrastAuto"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="40"
                    android:gravity="center"
                    android:text="@string/viewer_defaults_mode_auto"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="40"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/buttonDefaultContrastOn"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@color/transparent"
                        android:contentDescription="@string/viewer_defaults_mode_always_on"
                        android:padding="10dp"
                        app:srcCompat="@drawable/ic_light_on"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/viewer_defaults_mode_on_short"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/containerNightLightSchedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/border_rounded"
                android:orientation="horizontal"
                android:visibility="gone"
                android:weightSum="100">

                <TextView
                    android:id="@+id/buttonDefaultNightLightStartTime"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="50"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    tools:text="21:00" />

                <TextView
                    android:id="@+id/buttonDefaultNightLightEndTime"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="50"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    tools:text="07:00" />
            </LinearLayout>

            <View
                android:id="@+id/separatorNightLightActions"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="?attr/colorSecondary" />

            <TextView
                android:id="@+id/buttonResetViewerDefaults"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/button_rounded_no_border"
                android:contentDescription="@string/viewer_defaults_reset"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/viewer_defaults_reset"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="normal" />

            <TextView
                android:id="@+id/buttonClearRecents"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/button_rounded_no_border"
                android:contentDescription="@string/viewer_defaults_clear_recents"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/viewer_defaults_clear_recents"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="normal" />

            <TextView
                android:id="@+id/textAppVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/dark_red"
                android:textSize="13sp"
                tools:text="Version 1.0.0" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
