    <string name="text_donate_liberapay">Du åbnede app\'en allerede {n_times} gange. Jeg håber du kan lide det. Hvis det er, og du ønsker at støtte mit arbejde, overveje at købe mig en kaffe.</string>
    <string name="button_donate_liberapay">Donér nu!</string>
    <string name="text_follow_on_instagram_the_app">Jeg har netop oprettet Instagram-kontoen i appen.\nDer, vil du finde tips, nysgerrigheder og noget andet! 😉\nFølg det nu 💙</string>
