    <string name="text_donate_liberapay">You opened the app already {n_times} times. I hope you like it. If it is and you want to support my work, consider to buy me a coffee.</string>
    <string name="button_donate_liberapay">Spende jetzt!</string>
    <string name="text_follow_on_instagram_the_app">Ich habe gerade den Instagram-Account der App erstellt.\nDort findest du Tipps, Kuriositäten und etwas anderes! 😉\nFolge ihm jetzt 💙</string>
