<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 3 styled bottom navigation bar. -->
    <style name="Widget.App.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/App.BottomNavigationView.ActiveIndicator</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">8dp</item>
    </style>

    <!-- Pill-shaped active indicator behind the selected item (Material 3 look). -->
    <style name="App.BottomNavigationView.ActiveIndicator" parent="">
        <item name="android:width">64dp</item>
        <item name="android:height">32dp</item>
        <item name="marginHorizontal">4dp</item>
        <item name="android:color">@color/nav_active_indicator</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.NavIndicator</item>
    </style>

    <style name="ShapeAppearance.App.NavIndicator" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
</resources>
