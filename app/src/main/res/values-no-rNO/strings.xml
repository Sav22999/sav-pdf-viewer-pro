    <string name="text_donate_liberapay">Du åpnet appen allerede {n_times} ganger. Jeg håper du liker den. Hvis det er og du vil støtte arbeidet mitt, vurder å kjøpe meg en kaffe.</string>
    <string name="button_donate_liberapay">Doner nå!</string>
    <string name="text_follow_on_instagram_the_app">Jeg har nettopp opprettet Instagram-kontoen til appen.\nDa finner du tips, nysgjerrige og noe annet! 😉\nFølg den nå 💙</string>
